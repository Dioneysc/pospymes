rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada negocio solo puede leer y escribir su propia carpeta (la del usuario con el que inicia sesión)
    match /negocios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
